                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="customerStatusLabel" text="Status: Online" textFill="#2ecc71">
                                 <font>
                                    <Font name="System" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                           <VBox.margin>
                              <Insets bottom="10.0" />
