                              </Button>
                              <Button layoutX="12.0" layoutY="238.0" mnemonicParsing="false" onAction="#handleAddMovieBtn" prefHeight="35.0" prefWidth="175.0" styleClass="nav-btn" stylesheets="@designDashboard.css" text="Add Movies">
