<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" styleClass="content-area" stylesheets="@customer.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CustomerDashboardController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Available Movies">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="movieTable" layoutX="14.0" layoutY="50.0" prefHeight="300.0" prefWidth="822.0">
        <columns>
          <TableColumn fx:id="titleColumn" prefWidth="250.0" text="Movie Title" />
          <TableColumn fx:id="genreColumn" prefWidth="200.0" text="Genre" />
          <TableColumn fx:id="durationColumn" prefWidth="150.0" text="Duration" />
          <TableColumn fx:id="dateColumn" prefWidth="220.0" text="Showing Date" />
        </columns>
      </TableView>
      <AnchorPane layoutX="14.0" layoutY="370.0" prefHeight="200.0" prefWidth="822.0" styleClass="poster-container">
         <children>
            <ImageView fx:id="posterImageView" fitHeight="180.0" fitWidth="135.0" layoutX="344.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane> 